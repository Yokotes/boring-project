// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id  Int @id @default(autoincrement())
  name String @unique
  password String
}

model Exercise {
  id Int @id @default(autoincrement())
  title String
  description String
  imageUrl String?
}